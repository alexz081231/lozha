# Пример nginx для Ложи: замени example.com на свой домен и положи в /etc/nginx/sites-available/lozha.
# Node (127.0.0.1:3000) проверяет вход и доступ, сами файлы отдаёт nginx через X-Accel-Redirect.
# Сертификат: sudo certbot certonly --webroot -w /var/www/letsencrypt -d example.com

server {
    listen 80;
    listen [::]:80;
    server_name example.com;

    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://example.com$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name example.com;

    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # Ограничение частоты запросов (зоны объявляются в http {} в nginx.conf):
    #   limit_req_zone $binary_remote_addr zone=lozha_req:10m rate=30r/s;
    #   limit_conn_zone $binary_remote_addr zone=lozha_conn:10m;
    # limit_req  zone=lozha_req burst=200 nodelay;
    # limit_conn lozha_conn 60;

    # Загрузка идёт кусками по 8 МБ
    client_max_body_size 9m;
    client_body_buffer_size 1m;
    client_body_timeout 180s;
    send_timeout 120s;

    location ~ /\. { deny all; }

    # Видео, музыка, постеры, субтитры: только после проверки доступа в Node (internal)
    location /_media/ {
        internal;
        alias /var/lib/lozha/media/;
        sendfile on;
        tcp_nopush on;
        sendfile_max_chunk 2m;
        add_header X-Content-Type-Options nosniff always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    # Живые события: WebSocket
    location = /ws {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Запасной канал событий (SSE): без буферизации
    location = /api/rt/stream {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # Начало загрузки и список незавершённых (без этого точного правила nginx перенаправил бы на адрес со слешем)
    location = /api/uploads {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Куски загружаемых файлов: сразу в Node, без временных файлов nginx
    location /api/uploads/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
